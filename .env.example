# Application database (checkpoint five)
DATABASE_URL=postgresql+psycopg://nfl_coaching:nfl_coaching@localhost:5432/nfl_coaching
POSTGRES_DB=nfl_coaching
POSTGRES_USER=nfl_coaching
POSTGRES_PASSWORD=replace_for_local_use
# Disposable PostgreSQL database used only by behavioral schema tests
TEST_DATABASE_URL=postgresql://nfl_coaching:nfl_coaching@localhost:5432/nfl_coaching_test

# Deferred college-data enrichment. Leave blank until explicitly enabled.
CFBD_API_KEY=

# nflreadpy cache configuration (checkpoint two)
NFLREADPY_CACHE=filesystem
NFLREADPY_CACHE_DIR=.cache/nflreadpy
NFLREADPY_VERBOSE=false

# Application defaults
ANALYSIS_START_SEASON=2010
ANALYSIS_END_SEASON=2025
DEFAULT_MIN_DROPBACKS=200
DEFAULT_MIN_COACH_QB_SEASONS=3
DEFAULT_MIN_COACH_QBS=2
