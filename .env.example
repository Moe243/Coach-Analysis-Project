# Application database (checkpoint seven). Keep real credentials only in .env.
DATABASE_URL=postgresql://nfl_coaching:nfl_coaching@localhost:5432/nfl_coaching
POSTGRES_DB=nfl_coaching
POSTGRES_USER=nfl_coaching
POSTGRES_PASSWORD=replace_for_local_use
# Optional external disposable PostgreSQL database. `make test-postgres` starts a
# bundled isolated server when this is unset.
TEST_DATABASE_URL=postgresql://nfl_coaching:nfl_coaching@localhost:5432/nfl_coaching_test

# Comma-separated browser origins allowed to call the API. Production must use
# the exact deployed frontend origin; wildcards are rejected.
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# Deferred college-data enrichment. Leave blank until explicitly enabled.
CFBD_API_KEY=

# nflreadpy cache configuration (checkpoint two)
NFLREADPY_CACHE=filesystem
NFLREADPY_CACHE_DIR=.cache/nflreadpy
NFLREADPY_VERBOSE=false

# Application defaults
ANALYSIS_START_SEASON=2010
ANALYSIS_END_SEASON=2025
DEFAULT_MIN_DROPBACKS=200
DEFAULT_MIN_COACH_QB_SEASONS=3
DEFAULT_MIN_COACH_QBS=2

# Frontend. The browser uses a same-origin path; the Vite development server
# proxies that path to the separately configured local API target.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
